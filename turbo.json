{
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "dock-host": {
        "dependencies": {
          "allow": ["dock-tooling"]
        }
      },
      "dock-tooling": {
        "dependencies": {
          "allow": ["dock-tooling"]
        }
      }
    }
  },
  "tasks": {
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:install": {
      "dependsOn": ["@ykdz/dock#pack"],
      "cache": false,
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint": {
      "dependsOn": ["^lint"],
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "dependsOn": ["//#lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#test:task-gates": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#release:verify": {
      "cache": false,
      "tags": ["work:release"]
    },
    "//#release:publish": {
      "cache": false,
      "tags": ["work:release"]
    },
    "//#release:registry": {
      "cache": false,
      "tags": ["work:release"]
    },
    "//#release:github": {
      "cache": false,
      "tags": ["work:release"]
    },
    "//#test:release": {
      "outputs": [],
      "tags": ["quality:light"]
    }
  },
  "globalDependencies": [
    "LICENSE",
    "oxfmt.config.ts",
    "oxlint.config.ts",
    "packages/tooling-config/oxfmt.config.ts",
    "packages/tooling-config/oxlint.config.ts"
  ]
}
