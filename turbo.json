{
  "boundaries": {
    "tags": {
      "library": {
        "dependencies": {
          "allow": ["library"]
        }
      },
      "dock-core": {
        "dependencies": {
          "allow": ["dock-tooling"]
        }
      },
      "dock-sdk": {
        "dependencies": {
          "allow": ["dock-core", "dock-tooling"]
        }
      },
      "dock-reference": {
        "dependencies": {
          "allow": ["dock-core", "dock-sdk", "dock-tooling", "dock-reference"]
        }
      },
      "dock-tooling": {
        "dependencies": {
          "allow": ["dock-tooling"]
        }
      },
      "dock-node-test": {
        "dependencies": {
          "deny": ["dock-vitest"]
        }
      },
      "dock-vitest": {
        "dependencies": {
          "deny": ["dock-node-test"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CARGO_HOME", "RUSTUP_HOME", "RUSTUP_TOOLCHAIN"],
  "tasks": {
    "//#check": {
      "tags": ["quality:entry"]
    },
    "//#check:heavy": {
      "tags": ["quality:entry"]
    },
    "//#check:full": {
      "tags": ["quality:entry"]
    },
    "//#check:install": {
      "dependsOn": [
        "@dock/core#pack",
        "@dock/sdk#pack",
        "@dock/reference-file#pack",
        "@dock/reference-markdown#pack",
        "@dock/reference-node-test#pack",
        "@dock/reference-vitest#pack",
        "@dock/reference-typescript#pack"
      ],
      "cache": false,
      "outputs": [],
      "tags": ["quality:heavy"]
    },
    "//#boundaries": {
      "tags": ["quality:light"]
    },
    "//#fix": {
      "tags": ["work:repair"]
    },
    "//#format:check": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#lint": {
      "outputs": [],
      "tags": ["quality:light"]
    },
    "//#format:write": {
      "dependsOn": ["//#lint:fix"],
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#lint:fix": {
      "cache": false,
      "tags": ["work:repair"]
    },
    "//#typecheck": {
      "outputs": [],
      "tags": ["quality:light"]
    }
  }
}
