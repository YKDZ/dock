{
  "name": "dock",
  "private": true,
  "type": "module",
  "exports": {
    "./README.md": "./README.md",
    "./package.json": "./package.json"
  },
  "scripts": {
    "boundaries": "turbo boundaries",
    "check": "node --conditions=source scripts/task-gates.ts check",
    "check:install": "node --conditions=source scripts/check-installed.ts",
    "fix": "node --conditions=source scripts/task-gates.ts fix",
    "format:check": "oxfmt --list-different --no-error-on-unmatched-pattern README.md CHANGELOG.md *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .changeset/config.json .devcontainer resources scripts template test",
    "format:write": "oxfmt --write --no-error-on-unmatched-pattern README.md CHANGELOG.md *.json pnpm-workspace.yaml pnpm-lock.yaml *.config.ts .gitignore .dockerignore Dockerfile TODO.md rust-toolchain.toml .vscode .github .changeset/config.json .devcontainer resources scripts template test",
    "lint": "oxlint --quiet --format=unix --no-error-on-unmatched-pattern *.config.ts scripts",
    "lint:fix": "oxlint --format=unix --no-error-on-unmatched-pattern *.config.ts scripts --fix",
    "typecheck": "tsc --build --noEmit --pretty false",
    "test:task-gates": "node --conditions=source --test --test-reporter=spec scripts/task-gates.test.ts",
    "check:heavy": "node --conditions=source scripts/task-gates.ts check:heavy",
    "check:full": "node --conditions=source scripts/task-gates.ts check:full",
    "release:verify": "node scripts/release.ts verify",
    "release:publish": "node scripts/release.ts publish",
    "release:registry": "node scripts/release.ts registry",
    "release:github": "node scripts/release.ts release",
    "test:release": "node --test scripts/release.test.ts"
  },
  "devDependencies": {
    "@dock/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "turbo": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "26.13.1"
  },
  "packageManager": "pnpm@12.21.0"
}
