{
  "name": "@dock/consumer-readme",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false",
    "dock:check": "dock check --config dock.config.ts",
    "dock:baseline": "dock baseline update --config dock.config.ts && oxfmt --write dock.baseline.json"
  },
  "devDependencies": {
    "@dock/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "@ykdz/dock": "workspace:*",
    "dock": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "^26.13.1"
  }
}
