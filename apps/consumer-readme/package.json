{
  "name": "@dock/consumer-readme",
  "private": true,
  "type": "module",
  "scripts": {
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "dock:check": "node --conditions=source --input-type=module -e 'import \"@ykdz/dock/cli\"' -- dock check --config dock.config.ts",
    "dock:baseline": "node --conditions=source --input-type=module -e 'import \"@ykdz/dock/cli\"' -- dock baseline update --config dock.config.ts && oxfmt --write dock.baseline.json"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@ykdz/dock": "workspace:*",
    "@ykdz/dock-reference-file": "workspace:*",
    "@ykdz/dock-reference-markdown": "workspace:*",
    "@ykdz/dock-reference-node-test": "workspace:*",
    "dock": "workspace:*",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24.21.0"
  }
}
