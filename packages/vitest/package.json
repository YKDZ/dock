{
  "name": "@dock/vitest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./setup": {
      "source": "./src/setup.ts",
      "types": "./dist/setup.d.ts",
      "default": "./dist/setup.js"
    },
    "./reporter": {
      "source": "./src/reporter.ts",
      "types": "./dist/reporter.d.ts",
      "default": "./dist/reporter.js"
    },
    "./overlay-config": {
      "source": "./src/overlay-config.ts",
      "types": "./dist/overlay-config.d.ts",
      "default": "./dist/overlay-config.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@dock/core": "workspace:*",
    "@dock/host": "workspace:*"
  },
  "devDependencies": {
    "@dock/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "5.1.1"
  },
  "peerDependencies": {
    "vitest": "4.1.11 || 5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^26.13.1"
  }
}
