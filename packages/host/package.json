{
  "name": "@ykdz/dock",
  "version": "0.2.0",
  "homepage": "https://github.com/YKDZ/dock",
  "bugs": {
    "url": "https://github.com/YKDZ/dock/issues"
  },
  "license": "MIT",
  "author": "YKDZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/dock.git",
    "directory": "packages/host"
  },
  "bin": {
    "dock": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./core": {
      "source": "./src/core/index.ts",
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./markdown": {
      "source": "./src/markdown/index.ts",
      "types": "./dist/markdown/index.d.ts",
      "default": "./dist/markdown/index.js"
    },
    "./typescript": {
      "source": "./src/typescript/index.ts",
      "types": "./dist/typescript/index.d.ts",
      "default": "./dist/typescript/index.js"
    },
    "./node-test": {
      "source": "./src/node-test/index.ts",
      "types": "./dist/node-test/index.d.ts",
      "default": "./dist/node-test/index.js"
    },
    "./vitest": {
      "source": "./src/vitest/index.ts",
      "types": "./dist/vitest/index.d.ts",
      "default": "./dist/vitest/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --pretty false && chmod +x dist/cli.js",
    "pack": "mkdir -p .artifacts && pnpm pack --out .artifacts/package.tgz",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules . && node scripts/check-core-import-boundaries.ts",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.node.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/cli-contract": "0.7.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-gfm": "3.0.0",
    "micromark-extension-gfm": "3.0.0",
    "parse5": "8.0.0",
    "typescript": "5.9.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@dock/tooling-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "tsrs": "catalog:",
    "typescript-7": "catalog:",
    "vitest": "4.1.11"
  },
  "peerDependencies": {
    "vitest": "4.1.11 || 5.0.3"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "engines": {
    "node": "^26.13.1"
  }
}
