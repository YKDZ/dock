{
  "name": "@ykdz/dock",
  "version": "0.2.0",
  "homepage": "https://github.com/YKDZ/dock",
  "bugs": {
    "url": "https://github.com/YKDZ/dock/issues"
  },
  "license": "MIT",
  "author": "YKDZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/dock.git",
    "directory": "packages/host"
  },
  "bin": {
    "dock": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./cli": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "pack": "mkdir -p .artifacts && pnpm pack --out .artifacts/package.tgz",
    "test": "node --conditions=source --test --test-reporter=spec 'test/**/*.test.ts'",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules .",
    "lint:fix": "oxlint --format=unix . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "dependencies": {
    "@ykdz/cli-contract": "0.3.0",
    "@ykdz/dock-core": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
