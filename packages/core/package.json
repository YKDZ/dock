{
  "name": "@ykdz/dock-core",
  "version": "0.1.0",
  "homepage": "https://github.com/YKDZ/dock",
  "bugs": {
    "url": "https://github.com/YKDZ/dock/issues"
  },
  "license": "MIT",
  "author": "YKDZ",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YKDZ/dock.git",
    "directory": "packages/core"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "pack": "mkdir -p .artifacts && pnpm pack --out .artifacts/package.tgz",
    "format:check": "oxfmt --list-different .",
    "format:write": "oxfmt --write .",
    "lint": "oxlint --quiet --format=unix --ignore-pattern node_modules . && node scripts/check-import-boundaries.ts",
    "lint:fix": "oxlint --format=unix . --fix",
    "test": "node --conditions=source --test --test-reporter=spec --test-reporter=./scripts/node-test-count-reporter.ts --test-reporter-destination=stdout --test-reporter-destination=stderr 'test/**/*.test.ts'",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "devDependencies": {
    "@dock/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript-7": "catalog:"
  },
  "engines": {
    "node": "24"
  }
}
